# Backend environment — placeholders only. Never commit real secrets.
PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL connection for application data (required; no in-memory fallback).
# Example for local PostgreSQL:
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/bankapp
# SSL mode for hosted providers: empty for local dev, "true" for encrypted
# connections without CA verification, "verify" for full verification.
PGSSL=

# Separate database used ONLY by automated tests. Must differ from DATABASE_URL.
# The test runner refuses to start otherwise and never touches the dev database.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/bankapp_test

# Demo administrator bootstrap (server-side only).
# When set, the server creates this admin on startup if the email is not present.
# Leave unset to run without a seeded admin.
ADMIN_NAME=Demo Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-password
